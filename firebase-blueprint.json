    "SecurityAuditLog": {
      "title": "SecurityAuditLog",
      "description": "Bitácora inmutable de auditoría de seguridad para cumplimiento SUDEBAN y SENIAT.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "accion": { "type": "string", "minLength": 2, "maxLength": 120 },
        "entidadTipo": {
          "type": "string",
          "enum": ["EMPRESA", "ANTICIPO_BANESCO", "VIGILANTE_LOTTT", "SISTEMA_AUTH", "TASA_BCV", "COMPROBANTE_SENIAT"]
        },
        "entidadId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "detalle": { "type": "string", "minLength": 2, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "ownerId",
        "accion",
        "entidadTipo",
        "entidadId",
        "detalle",
        "createdAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Registro de administrador verificado del sistema.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["admin"] }
      },
      "required": ["uid", "role"]
    },
    "BcvDailyRate": {
      "title": "BcvDailyRate",
      "description": "Registro de tasa de cambio diaria oficial del Banco Central de Venezuela (Compra y Venta) para reconversión automática por fecha de operación.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fecha": { "type": "string", "minLength": 8, "maxLength": 20 },
        "tasaCompraVES": { "type": "number" },
        "tasaVentaVES": { "type": "number" },
        "fuente": { "type": "string", "minLength": 2, "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "ownerId",
        "fecha",
        "tasaCompraVES",
        "tasaVentaVES",
        "fuente",
        "createdAt",
        "updatedAt"
      ]
    },
    "SignedVoucherRecord": {
      "title": "SignedVoucherRecord",
      "description": "Comprobante contable y legal de Agrícola Oni, C.A. resguardado en el Repositorio SENIAT/Banesco, incluyendo estado de firma/sello y soporte digitalizado.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "voucherId": { "type": "string", "minLength": 2, "maxLength": 80 },
        "numeroComprobante": { "type": "string", "minLength": 3, "maxLength": 80 },
        "hojaDestino": { "type": "string", "minLength": 3, "maxLength": 60 },
        "mes": { "type": "string", "minLength": 2, "maxLength": 10 },
        "fechaEmision": { "type": "string", "minLength": 6, "maxLength": 20 },
        "montoOperacionBs": { "type": "number" },
        "montoEquivalenteUSD": { "type": "number" },
        "estadoFirmaSello": {
          "type": "string",
          "enum": [
            "EMITIDO_PENDIENTE_FIRMA",
            "IMPRESO_EN_TRAMITE_FIRMA",
            "FIRMADO_Y_SELLADO_DIGITALIZADO",
            "VERIFICADO_AUDITORIA_SENIAT"
          ]
        },
        "archivoFirmadoNombre": { "type": "string", "minLength": 1, "maxLength": 200 },
        "archivoFirmadoFechaCarga": { "type": "string", "minLength": 4, "maxLength": 40 },
        "archivoFirmadoHashSha256": { "type": "string", "minLength": 6, "maxLength": 128 },
        "firmadoPorRepresentante": { "type": "string", "minLength": 2, "maxLength": 160 },
        "firmadoPorContadorCpc": { "type": "string", "minLength": 2, "maxLength": 160 },
        "selloAgenciaBanesco": { "type": "string", "minLength": 2, "maxLength": 160 },
        "expedienteSeniatNro": { "type": "string", "minLength": 2, "maxLength": 100 },
        "observacionesAuditor": { "type": "string", "minLength": 2, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "ownerId",
        "voucherId",
        "numeroComprobante",
        "hojaDestino",
        "mes",
        "fechaEmision",
        "montoOperacionBs",
        "montoEquivalenteUSD",
        "estadoFirmaSello",
        "archivoFirmadoNombre",
        "archivoFirmadoFechaCarga",
        "archivoFirmadoHashSha256",
        "firmadoPorRepresentante",
        "firmadoPorContadorCpc",
        "selloAgenciaBanesco",
        "expedienteSeniatNro",
        "observacionesAuditor",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/CompanyProfile" },
      "description": "Empresas registradas por cada usuario autenticado en el sistema multiempresa."
    },
    "/operations/{operationId}": {
      "schema": { "$ref": "#/entities/CashTrailOperation" },
      "description": "Operaciones de anticipos en ventas en Banesco y trazabilidad cambiaria."
    },
    "/vigilantes/{vigilanteId}": {
      "schema": { "$ref": "#/entities/VigilanteWorker" },
      "description": "Nómina de vigilantes rurales asociada a una empresa del usuario."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/SecurityAuditLog" },
      "description": "Bitácora inmutable de eventos financieros y fiscales."
    },
    "/bcvRates/{rateId}": {
      "schema": { "$ref": "#/entities/BcvDailyRate" },
      "description": "Histórico de tasas diarias de compra y venta del Banco Central de Venezuela importadas desde Excel."
    },
    "/signedVouchers/{voucherDocId}": {
      "schema": { "$ref": "#/entities/SignedVoucherRecord" },
      "description": "Repositorio de comprobantes contables y legales firmados y sellados para revisiones del SENIAT y Banesco."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Colección de solo lectura para verificación de rol administrativo."
    }
  }
}
