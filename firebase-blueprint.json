        "estadoContable",
        "etapaTrazabilidad",
        "reciboAnticipoNro",
        "createdAt",
        "updatedAt"
      ]
    },
    "VigilanteWorker": {
      "title": "VigilanteWorker",
      "description": "Trabajador de vigilancia y resguardo rural agroindustrial bajo normativa LOTTT.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "empresaId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nombre": { "type": "string", "minLength": 2, "maxLength": 160 },
        "cedula": { "type": "string", "minLength": 4, "maxLength": 30 },
        "cargo": { "type": "string", "minLength": 2, "maxLength": 120 },
        "ubicacionFinca": { "type": "string", "minLength": 2, "maxLength": 200 },
        "turnoModalidad": {
          "type": "string",
          "enum": [
            "Rotativo 12x12 (Guardia Diurna/Nocturna)",
            "Esquema 24x48 (Vigilancia Rural Agropecuaria)",
            "Nocturno Fijo (6:00 PM a 6:00 AM)"
          ]
        },
        "salarioBasicoMensualVES": { "type": "number" },
        "diasTrabajadosMes": { "type": "number" },
        "horasNocturnasMes": { "type": "number" },
        "horasExtrasMes": { "type": "number" },
        "domingosFeriadosTrabajados": { "type": "number" },
        "cestaticketUSD": { "type": "number" },
        "bonoProductividadResguardoUSD": { "type": "number" },
