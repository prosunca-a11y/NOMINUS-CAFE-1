        "tasaBcvAnticipo",
        "fechaMesaCambio",
        "horaMesaCambio",
        "codigoPactoBanesco",
        "tasaMesaCambio",
        "comisionBanescoVES",
        "montoAdjudicadoUSD",
        "cuentaBanescoDivisas",
        "fechaCompraExterior",
        "referenciaPagoExterior",
        "proveedorExterior",
        "origenCafe",
        "variedadCafe",
        "quintalesComprados",
        "costoCafeUSD",
        "fleteInternacionalUSD",
        "estadoLogistico",
        "permisoInsai",
        "numeroFacturaSeniat",
        "fechaFacturaSeniat",
        "tasaBcvFacturacion",
