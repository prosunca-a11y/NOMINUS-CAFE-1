        "montoAdjudicadoUSD": { "type": "number" },
        "cuentaBanescoDivisas": { "type": "string", "minLength": 5, "maxLength": 120 },
        "fechaCompraExterior": { "type": "string", "minLength": 4, "maxLength": 30 },
        "referenciaPagoExterior": { "type": "string", "minLength": 3, "maxLength": 80 },
        "proveedorExterior": { "type": "string", "minLength": 2, "maxLength": 200 },
        "origenCafe": { "type": "string", "minLength": 2, "maxLength": 200 },
        "variedadCafe": {
          "type": "string",
          "enum": [
            "Café Verde Arábica Lavado",
            "Café Pergamino Seco",
            "Café Verde Caturra Excelso"
          ]
        },
        "quintalesComprados": { "type": "number" },
        "costoCafeUSD": { "type": "number" },
        "fleteInternacionalUSD": { "type": "number" },
        "estadoLogistico": {
          "type": "string",
          "enum": [
            "En Almacén Colombia (Trámite INSAI)",
            "En Tránsito Frontera (San Antonio / Ureña)",
            "Entregado y Facturado en Venezuela"
          ]
        },
        "permisoInsai": { "type": "string", "minLength": 2, "maxLength": 120 },
        "numeroFacturaSeniat": { "type": "string", "minLength": 2, "maxLength": 80 },
        "fechaFacturaSeniat": { "type": "string", "minLength": 4, "maxLength": 30 },
        "tasaBcvFacturacion": { "type": "number" },
        "subtotalCafeVES": { "type": "number" },
        "subtotalFleteVES": { "type": "number" },
        "ivaFleteVES": { "type": "number" },
        "retencionIslrFleteVES": { "type": "number" },
        "diferencialCambiarioVES": { "type": "number" },
        "estadoContable": {
          "type": "string",
          "enum": [
            "Anticipo Abierto (Pasivo 2.1.04)",
            "Divisas En Custodia Banesco",
            "Cerrado y Declarado SENIAT"
          ]
        },
        "etapaTrazabilidad": { "type": "number" },
        "reciboAnticipoNro": { "type": "string", "minLength": 3, "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "ownerId",
        "empresaId",
        "uidUnico",
        "codigoOperacion",
        "fechaAnticipo",
        "horaTransferencia",
