{
  "entities": {
    "CompanyProfile": {
      "title": "CompanyProfile",
      "description": "Sociedad mercantil venezolana registrada en el sistema multiempresa NOMINUS CAFÉ 1 con sus cuentas Banesco y cupo de Mesa de Cambio.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "codigoCorto": { "type": "string", "minLength": 1, "maxLength": 40 },
        "razonSocial": { "type": "string", "minLength": 2, "maxLength": 200 },
        "rif": { "type": "string", "minLength": 5, "maxLength": 30 },
        "domicilioFiscal": { "type": "string", "minLength": 2, "maxLength": 400 },
        "registroMercantil": { "type": "string", "minLength": 2, "maxLength": 300 },
        "representanteLegal": { "type": "string", "minLength": 2, "maxLength": 160 },
        "cuentaBanescoVES": { "type": "string", "minLength": 10, "maxLength": 60 },
        "cuentaBanescoUSD": { "type": "string", "minLength": 10, "maxLength": 120 },
        "cupoMensualMesaCambioUSD": { "type": "number" },
        "sucursalPrincipal": { "type": "string", "minLength": 2, "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "ownerId",
        "codigoCorto",
        "razonSocial",
        "rif",
        "domicilioFiscal",
        "registroMercantil",
        "representanteLegal",
        "cuentaBanescoVES",
        "cuentaBanescoUSD",
        "cupoMensualMesaCambioUSD",
        "sucursalPrincipal",
        "createdAt",
        "updatedAt"
      ]
    },
    "CashTrailOperation": {
      "title": "CashTrailOperation",
      "description": "Registro exhaustivo de anticipo en ventas recibido en Banesco y su trazabilidad de 4 etapas hasta la compra de café en el exterior y facturación SENIAT.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "empresaId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uidUnico": { "type": "string", "minLength": 5, "maxLength": 80 },
        "codigoOperacion": { "type": "string", "minLength": 3, "maxLength": 60 },
        "fechaAnticipo": { "type": "string", "minLength": 8, "maxLength": 30 },
        "horaTransferencia": { "type": "string", "minLength": 4, "maxLength": 20 },
